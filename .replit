modules = ["nodejs-20", "web", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project-1.0/artifacts/am0sp-customer: web"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["buildpack", "gut"]

[userenv]

[userenv.production]
VITE_APP_URL = "https://project-1-0.amo5420000.workers.dev"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8976
externalPort = 3000
exposeLocalhost = true
