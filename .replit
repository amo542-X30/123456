modules = ["nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project-1.0/artifacts/am0sp-customer: web"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["buildpack", "gut"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8976
externalPort = 3000
exposeLocalhost = true
